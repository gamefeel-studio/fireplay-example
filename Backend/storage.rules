rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The example's Storage screen reads and writes under demo/ only,
    // for signed-in players (anonymous sign-in is enough), up to 10 MB a file.
    match /demo/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
