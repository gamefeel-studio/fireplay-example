rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-player data (coin balance): only the signed-in owner can read or
    // write it, and the balance can never become negative.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && (!('coins' in request.resource.data)
            || (request.resource.data.coins is int && request.resource.data.coins >= 0));
    }

    // Shared playground collections used by the demo's Firestore screen
    // (demo, demo_scores, demo_bank, demo_chat...).
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection.matches('demo.*');
    }
  }
}
